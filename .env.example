# --- Database ---------------------------------------------------------------
# SQLite for local dev. Swap to a Postgres URL for deploy (also flip the
# datasource provider in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# --- Public base URL --------------------------------------------------------
# Used to build absolute links for QR codes and the shareable spec link. Leave
# blank for local dev (the app derives it from the request host). Set this in
# production so QR codes point at your real domain, e.g. https://chairside.app
APP_URL=""

# --- Retention window -------------------------------------------------------
# A return visit counts toward the rebooking metric if it lands within this
# many days of the prior visit at the same shop. Default 6 weeks.
RETENTION_WINDOW_DAYS=42

# --- Optional AI render (feature-flagged, NEVER load-bearing for the spec) ---
# The spec sheet's numbers are ALWAYS derived from structured params. The image
# is illustrative only. If no key is set, the app shows a labeled placeholder.
# Leave RENDER_ENABLED=false unless you have wired a real image API. This same
# flag/key gates the try-on render that paints a style onto the client's photo.
RENDER_ENABLED="false"
RENDER_API_KEY=""
# Optional endpoint for the pluggable image-to-image / hair-inpainting provider
# used by the try-on render (only used when RENDER_ENABLED=true and a key is set).
RENDER_PROVIDER_URL=""

# --- Visualization layer (selfie + multi-angle try-on) ----------------------
# Offers the guided photo-capture + try-on step in the client flow. The
# generative render still respects RENDER_ENABLED above: when that's off (or no
# key), the try-on shows a clearly-labeled deterministic STUB composite of the
# client's own photo + the chosen spec — never a fake "AI" result.
VISUALIZATION_ENABLED="true"

# Where captured photos + renders are stored in dev: a filesystem stub, kept out
# of /public and out of git, served only via the gated /api/photos|/api/renders
# routes. Swappable for S3/GCS in production (see src/lib/storage.ts).
STORAGE_DIR=".uploads"

# --- Booking-platform integration + QR onboarding ---------------------------
# Tiered: deep (Square) where allowed, trigger (Zapier) where webhooks exist, and
# a universal static-QR fallback everywhere else. Personalized links carry an
# opaque token only — NEVER PII in a URL.
INTEGRATIONS_ENABLED="true"
BOOKING_TOKEN_TTL_DAYS="14"

# Tier 1 — Square Appointments (deep). Leave SQUARE_ENABLED=false to run the
# whole pipeline in a safe STUB mode (no live Square calls) for local demos —
# webhooks still match/create the profile and mint a personalized link.
SQUARE_ENABLED="false"
SQUARE_ENV="sandbox" # sandbox | production
SQUARE_APP_ID=""
SQUARE_APP_SECRET=""
SQUARE_WEBHOOK_SIGNATURE_KEY="" # from the Square webhook subscription
# Scopes requested at OAuth connect (the seller grants these). We READ bookings/
# customers and ATTACH the link via custom attributes; we never create bookings,
# so the free Appointments plan is enough. VERIFY exact custom-attribute scopes
# against current Square docs before a real connect.
SQUARE_OAUTH_SCOPES="APPOINTMENTS_READ APPOINTMENTS_ALL_READ CUSTOMERS_READ CUSTOMERS_WRITE APPOINTMENTS_BUSINESS_SETTINGS_READ CUSTOMER_CUSTOM_ATTRIBUTE_DEFINITIONS_WRITE CUSTOMER_CUSTOM_ATTRIBUTE_DEFINITIONS_READ"

# Tier 2 — Zapier / generic webhook. A shop's Zap signs requests with this
# shared secret in the X-Chairside-Secret header.
ZAPIER_WEBHOOK_SECRET=""

# Functional-only customer messaging (their booking's brief link — no marketing).
# Pluggable provider; stub (logs only) when disabled or no key.
MESSAGING_ENABLED="false"
MESSAGING_PROVIDER_URL=""
MESSAGING_API_KEY=""

# --- Barber dashboard auth (MVP-level) --------------------------------------
# A single shared passphrase gates the barber dashboard for the pilot. This is
# intentionally lightweight — NOT production multi-tenant auth (see Non-goals).
BARBER_ACCESS_CODE="letmein"
